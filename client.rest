@baseUrl = http://localhost:3000

@authToken = {{authenticate.response.body.accessToken}}

@refreshToken = {{authenticate.response.body.refreshToken}}

# RECADOS

### AppControllerGetHello
GET {{baseUrl}}/recados/
?limit=10
&offset=0
Authorization: Bearer {{authToken}}
Content-Type: application/json

###
GET {{baseUrl}}/recados/10

### Cria um recado
POST {{baseUrl}}/recados/
Authorization: Bearer {{authToken}}
Content-Type: application/json

 {
    "texto": "NOVO RECADO para usuario 9",
    "paraId": 9
 }

### atualiza um recado
PATCH {{baseUrl}}/recados/13/
Authorization: Bearer {{authToken}}
Content-Type: application/json

 {
    "texto": "Teste mudança de texto do recado",
    "lido": true
 }

###
DELETE {{baseUrl}}/recados/12
Authorization: Bearer {{authToken}}






